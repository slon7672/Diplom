# ==================================================ЛОКАТОРЫ=======================================================
# --------------------------------------ГЛАВНАЯ СТРАНИЦА (до авторизации)------------------------------------------
SIGN_IN_LINK_XPATH=//a[normalize-space()='Войти']

# ---------------------------------------------СТРАНИЦА АВТОРИЗАЦИИ------------------------------------------------
# поле ввода "email"
EMAIL_XPATH=//input[@autocomplete='email']
# поле ввода "password"
PASS_XPATH=//input[@autocomplete='current-password']
# кнопка аунтификации "войти"
LOGIN_BTN_XPATH=//div[@role='button' and contains(., 'Войти')]
# месседжи ошибки
LOGIN_ERR_XPATH=//div[contains(@class, 'login-error') and contains(., 'Неверный e-mail или пароль')]


# ---------------------------------------------------САЙДБАР-------------------------------------------------------

# блок левой панели
SIDE_BAR_XPATH=//div[@data-testid='left-sidebar']

# -----------------------------------------------СТРАНИЦА КОМПАНИИ-------------------------------------------------
MY_COMPANY_XPATH=//div[contains(@class, 'text-panel-text-primary') and contains(text(), 'Моя компания')]
NAME_PAGE_MY_COMPANY_XPATH=//div[contains(@class, 'text-sm-semibold') and contains(text(), 'Моя компания')]
# кнопка "+ Добавить проект" добавления проекта
ADD_PROJECT_XPATH=//*[contains(text(), 'Добавить проект')]
# кнопка из выпадающего списка
BTN_ADD_PROJECT_WITH_TASKS_XPATH=//div[@data-testid='menu-item-add-default-project']
# поле ввода наименования проекта
INPUT_NAME_PROJECT_XPATH=//input[@placeholder='Введите название проекта…']
#//input[@type='text' and @placeholder='Введите название проекта…']
INPUT_ID_PREFIX_XPATH=//div[normalize-space()='ID-префикс проекта']/following::input[1]
#//input[@type='text' and not(@placeholder)]
BTN_CREATE_PROJECT=//div[@role='button' and normalize-space()='Добавить проект с задачами']

# ---------------------------------------------РАБОТА ВНУТРИ КОМПАНИИ----------------------------------------------
# кнопка "+" на создание проекта
ADD_PROJECT_BTN_XPATH=//*[contains(text(), 'Добавить проект')]
# кнопка "проект с задачами" из выпадающего меню
PROJECT_TASK_XPATH=//div[@data-testid='menu-item-add-default-project']
# титул "новый проект с задачами"
PROJECT_W_XPATH=//div[contains(., 'Новый проект с задачами')]
# поле ввода названия проекта
IN_NAME_P_XPATH=//input[@placeholder='Введите название проекта…']
# поле ввода префикса проекта
IN_PREFIX_XPATH=//div[normalize-space()='ID-префикс проекта']/following::input[1]
# кнопка «добавить проект с задачами»
ADD_BTN_P_XPATH=//div[@role='button' and normalize-space()='Добавить проект с задачами']

# ---------------------------------------------РАБОТА ВНУТРИ ПРОЕКТА-----------------------------------------------
# кнопка "+" на добавление доски
BTN_ADD_BOARD_XPATH=//div[@data-testid="add-new-board"]
# кнопка "доска с задачами" из выпадающего меню
BTN_MENU_ADD_BOARD_XPATH=//div[@data-testid='menu-item-add-board-tasks']
# поле ввода наименования доски
INPUT_NAME_BOARD_XPATH=//div[@data-testid='board-tab' and @data-tab-id='new-tab']
# поле (контейнер) расположения досок на странице
BOARD_TABS_CONTAINER_XPATH=//div[contains(@class, 'board-tabs-container')]
# кнопка "+ Создать колонку"
BTN_ADD_COLUMN_XPATH=//div[@role='button']//span[contains(text(), 'Создать колонку')]

# --------------------------------------------------мессенжер------------------------------------------------------
MESSENGER_XPATH=//div[normalize-space()='Мессенджер']
NAME_PAGE_MESSENG_XPATH=//div[contains(text(), 'Чаты')]

# ------------------------------------------------лента событий----------------------------------------------------
EVENT_FEED_XPATH=//div[text()='Лента событий']
NAME_PAGE_EVENT_XPATH=//div[@data-testid="simple-page-title" and text()="Лента событий"]

